var numeroAleatorio = aleatorioEntre(1, 11)
var tentativas: inteiro = 0
var soma: inteiro = 0
var acertou = falso
var chute = 0
escreva("O número sorteado foi: ", numeroAleatorio)
enquanto (tentativas < 10 e (nao acertou)) {
    chute = inteiro(leia("Digite seu palpite (ou -1 para sair):"))
    se (chute != -1
) {
        tentativas = tentativas + 1
        soma = soma + chute
        se (chute == numeroAleatorio) {
            escreva('Parabéns, você acertou!')
            acertou = verdadeiro
        }
    }
}
escreva('Quantidade de valores lidos:' + texto(tentativas))
se (tentativas > 0) {
    var media = soma / tentativas
    escreva('Média dos valores lidos:' + texto(media))
}
